apiVersion: v1
kind: Config
preferences: {}
clusters:
  - name: {{ artifact.payload.infrastructure.name }}
    cluster:
      server: {{ artifact.payload.authentication.endpoint }}
      certificate-authority-data: {{ artifact.payload.authentication.cluster_ca_certificate }}
contexts:
  - name: {{ artifact.payload.infrastructure.name }}
    context:
      cluster: {{ artifact.payload.infrastructure.name }}
      user: {{ artifact.payload.infrastructure.name }}
      namespace: default
current-context: {{ artifact.payload.infrastructure.name }}
users:
  - name: {{ artifact.payload.infrastructure.name }}
    user:
      token: {{ artifact.payload.authentication.token }}
